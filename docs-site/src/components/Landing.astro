---
import { getCollection } from 'astro:content';
import { Icon } from '@astrojs/starlight/components';
import Roadmap from './Roadmap.astro';
import en from '../i18n/en.json';
import de from '../i18n/de.json';
import nl from '../i18n/nl.json';
import fr from '../i18n/fr.json';
import es from '../i18n/es.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const texts: Record<string, typeof en> = { en, de, nl, fr, es };
const locale = Astro.currentLocale && texts[Astro.currentLocale] ? Astro.currentLocale : 'en';
const L = { ...en.landing, ...texts[locale].landing };
const S = { ...en.sidebar, ...texts[locale].sidebar };
// English pages live at the root, the others under /de/, /nl/, ...
const prefix = locale === 'en' ? '' : `/${locale}`;
// These pages are English only, so their links and titles stay at the root.
const englishOnly = new Set(['roadmap', 'development', 'translating']);
const href = (slug: string) => `${base}${englishOnly.has(slug) ? '' : prefix}/${slug}/`;

const docs = await getCollection('docs');
const info = (slug: string) => docs.find((d) => d.id === (englishOnly.has(slug) || locale === 'en' ? slug : `${locale}/${slug}`))?.data;

const groups = [
	{
		title: S.start_here,
		pages: [
			['install', 'download'],
			['setup', 'setting'],
			['today', 'approve-check-circle'],
		],
	},
	{
		title: S.everyday_use,
		pages: [
			['chores', 'list-format'],
			['ai-help', 'random'],
			['ask-claude', 'comment-alt'],
			['my-home', 'open-book'],
			['away-mode', 'moon'],
			['pet', 'heart'],
		],
	},
	{
		title: S.nudges_and_the_wall,
		pages: [
			['nudges', 'clock'],
			['wall-board', 'laptop'],
		],
	},
	{
		title: S.more,
		pages: [
			['automations', 'puzzle'],
			['data-and-backups', 'cloud-download'],
			['troubleshooting', 'warning'],
			['roadmap', 'rocket'],
			['development', 'pencil'],
		],
	},
];

const features = [
	{ title: L.feature_1_title, text: L.feature_1_text, image: 'today.jpg', alt: L.feature_1_alt, page: 'chores' },
	{ title: L.feature_2_title, text: L.feature_2_text, image: 'settings.jpg', alt: L.feature_2_alt, page: 'nudges' },
	{ title: L.feature_3_title, text: L.feature_3_text, image: 'ai-help.jpg', alt: L.feature_3_alt, page: 'ai-help' },
	{ title: L.feature_4_title, text: L.feature_4_text, image: 'wall.jpg', alt: L.feature_4_alt, page: 'wall-board' },
];
---

<div class="landing">
	<section class="hero">
		<h1><span class="line">{L.hero_line_1}</span> <span class="line">{L.hero_line_2}</span></h1>
		<div class="hero-text">
			<p class="lead" set:html={L.lead} />
			<div class="buttons">
				<a
					href="https://my.home-assistant.io/redirect/hacs_repository/?owner=sandschi&repository=Boopli&category=integration"
					target="_blank"
					rel="noreferrer"
				>
					<img class="badge" src="https://my.home-assistant.io/badges/hacs_repository.svg" alt={L.badge_hacs_alt} />
				</a>
				<a href="https://my.home-assistant.io/redirect/config_flow_start/?domain=boopli" target="_blank" rel="noreferrer">
					<img class="badge" src="https://my.home-assistant.io/badges/config_flow_start.svg" alt={L.badge_setup_alt} />
				</a>
			</div>
			<div class="buttons">
				<a class="boopli-btn" href={href('install')}>{L.install_button}</a>
				<a class="boopli-btn quiet" href={href('setup')}>{L.setup_button}</a>
				<a class="boopli-btn quiet" href={href('welcome')}>{L.docs_button}</a>
			</div>
			<p class="small">{L.early_note}</p>
		</div>
		<img class="hero-art" src={`${base}/img/pet-room.png`} alt={L.hero_image_alt} />
	</section>

	<section class="steps">
		<h2>{L.steps_title}</h2>
		<ol>
			<li set:html={L.step_1} />
			<li set:html={L.step_2} />
			<li set:html={L.step_3} />
		</ol>
	</section>

	{
		features.map((f, i) => (
			<section class={`feature ${i % 2 ? 'flip' : ''}`}>
				<div class="feature-text">
					<h2>{f.title}</h2>
					<p>{f.text}</p>
					<a class="boopli-btn quiet" href={href(f.page)}>
						{L.read_more}
					</a>
				</div>
				<img src={`${base}/img/${f.image}`} alt={f.alt} loading="lazy" />
			</section>
		))
	}

	<section class="map">
		<h2 id="find-your-way">{L.find_your_way}</h2>
		<div class="groups">
			{
				groups.map((g) => (
					<div class="group">
						<h3>{g.title}</h3>
						<ul>
							{g.pages.map(([slug, icon]) => (
								<li>
									<a href={href(slug)}>
										<span class="ico">
											<Icon name={icon as any} size="1.3rem" />
										</span>
										<span>
											<strong>{info(slug)?.title}</strong>
											<span class="d">{info(slug)?.description}</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section class="next">
		<h2>{L.what_is_next}</h2>
		<p class="small">{L.what_is_next_note}</p>
		<Roadmap limit={3} more={true} />
	</section>
</div>
<style>
	.landing {
		display: grid;
		gap: 4.5rem;
		margin-top: 1rem;
	}
	.landing h1 {
		font-size: clamp(2rem, 4vw, 2.9rem);
		line-height: 1.1;
		margin: 0 0 1rem;
		text-wrap: balance;
	}
	.landing h1 .line {
		display: block;
	}
	.landing h2 {
		font-size: 2rem;
		margin: 0 0 0.8rem;
		border: 0;
	}
	.landing p {
		margin: 0;
	}
	.hero {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 2.5rem;
		align-items: center;
	}
	.hero h1 {
		grid-column: 1 / -1;
		margin-bottom: 0;
	}
	.lead {
		font-size: 1.3rem;
		line-height: 1.4;
		color: var(--sl-color-gray-1);
	}
	.buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		align-items: center;
		margin-top: 1.1rem;
	}
	.badge {
		height: 2.4rem;
		border: 0;
		border-radius: 0;
		display: block;
	}
	.small {
		margin-top: 1rem;
		font-size: 0.95rem;
		color: var(--sl-color-gray-3);
	}
	.hero-art {
		width: 100%;
		border-radius: 22px;
		border: 2px solid var(--sl-color-hairline-light);
	}
	.steps ol {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1.5rem;
		counter-reset: s;
	}
	.steps li {
		counter-increment: s;
		border-top: 3px solid var(--boopli-green);
		padding-top: 0.8rem;
		font-size: 1.15rem;
		line-height: 1.4;
	}
	.steps li::before {
		content: counter(s);
		display: inline-grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		margin-right: 0.6rem;
		border-radius: 50%;
		background: var(--boopli-green);
		color: var(--boopli-ink);
		font-size: 1.1rem;
	}
	.feature {
		display: grid;
		grid-template-columns: 1fr 1.25fr;
		gap: 2.5rem;
		align-items: center;
	}
	.feature.flip {
		grid-template-columns: 1.25fr 1fr;
	}
	.feature.flip .feature-text {
		order: 2;
	}
	.feature p {
		font-size: 1.2rem;
		line-height: 1.45;
		color: var(--sl-color-gray-1);
		margin-bottom: 1.1rem;
	}
	.feature img {
		width: 100%;
		border-radius: 18px;
		border: 2px solid var(--sl-color-hairline-light);
	}
	.groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
		gap: 2.2rem 2.5rem;
		margin-top: 1rem;
	}
	.group h3 {
		margin: 0 0 0.5rem;
		font-size: 1.3rem;
		color: var(--sl-color-accent-high);
		padding-bottom: 0.4rem;
		border-bottom: 3px solid var(--sl-color-hairline-light);
	}
	.group ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.group li a {
		display: flex;
		gap: 0.8rem;
		align-items: flex-start;
		padding: 0.6rem 0.5rem;
		border-radius: 12px;
		text-decoration: none;
		color: var(--sl-color-white);
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	.group li a:hover {
		background: var(--sl-color-gray-6);
	}
	.ico {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		border-radius: 10px;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
	}
	.group strong {
		display: block;
		font-weight: 400;
		font-size: 1.15rem;
	}
	.d {
		display: block;
		font-size: 0.95rem;
		color: var(--sl-color-gray-3);
		line-height: 1.3;
	}
	@media (max-width: 50rem) {
		.hero,
		.feature,
		.feature.flip {
			grid-template-columns: 1fr;
		}
		.feature.flip .feature-text {
			order: 0;
		}
		.landing {
			gap: 3rem;
		}
	}
</style>

<style is:global>
	/* the page title is the hero headline here, so Starlight's own title bar goes */
	body:has(.landing) .content-panel:has(> .sl-container > h1#_top) {
		display: none;
	}
	body:has(.landing) .main-pane .content-panel {
		padding-top: 0;
	}
</style>
