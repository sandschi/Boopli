---
import { getCollection } from 'astro:content';
import { Icon } from '@astrojs/starlight/components';
import Roadmap from './Roadmap.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = await getCollection('docs');
const info = (slug: string) => docs.find((d) => d.id === slug)?.data;

const groups = [
	{
		title: 'Start here',
		pages: [
			['install', 'download'],
			['setup', 'setting'],
			['today', 'approve-check-circle'],
		],
	},
	{
		title: 'Everyday use',
		pages: [
			['chores', 'list-format'],
			['ai-help', 'random'],
			['ask-claude', 'comment-alt'],
			['my-home', 'open-book'],
			['away-mode', 'moon'],
			['pet', 'heart'],
		],
	},
	{
		title: 'Nudges and the wall',
		pages: [
			['nudges', 'clock'],
			['wall-board', 'laptop'],
		],
	},
	{
		title: 'More',
		pages: [
			['automations', 'puzzle'],
			['data-and-backups', 'cloud-download'],
			['troubleshooting', 'warning'],
			['roadmap', 'rocket'],
			['development', 'pencil'],
		],
	},
];

const features = [
	{
		title: 'Tiny steps, one at a time',
		text: 'A big chore becomes a few very small steps. Boopli shows only the one that is your turn, with a big Done button. Steps can wait for a sensor, an NFC tag or a button, and finish by themselves.',
		image: 'today.jpg',
		alt: 'The Boopli Today screen',
		page: 'chores',
	},
	{
		title: 'Nudges that climb',
		text: 'A light blinks. A speaker dings, then speaks. A siren sounds if you really need it. Build your own ladders, per chore, and let your phone join in. Quiet hours and away mode keep it calm.',
		image: 'settings.jpg',
		alt: 'The Boopli Settings page',
		page: 'nudges',
	},
	{
		title: 'AI that breaks tasks down',
		text: 'Say "clean my room" and your own Home Assistant AI agent (or your own Claude, as an extra) asks a few questions and splits it into tiny steps that fit your home. Photos help it see what is out of place.',
		image: 'ai-help.jpg',
		alt: 'The AI help window',
		page: 'ai-help',
	},
	{
		title: 'A wall board for the tablet',
		text: 'A screen on the wall with the current step, the clock, the weather and your pet. Move and resize the tiles right on the wall, like a Home Assistant dashboard.',
		image: 'wall.jpg',
		alt: 'The wall board',
		page: 'wall-board',
	},
];
---

<div class="landing">
	<section class="hero">
		<div class="hero-text">
			<h1>Chores in tiny steps. A pet that cheers you on.</h1>
			<p class="lead">
				Boopli is an ADHD-friendly chore and task companion that lives inside <b>Home Assistant</b>. It nudges you with
				the lights, speakers and phone you already have. No account, no cloud, no server.
			</p>
			<div class="buttons">
				<a
					href="https://my.home-assistant.io/redirect/hacs_repository/?owner=sandschi&repository=Boopli&category=integration"
					target="_blank"
					rel="noreferrer"
				>
					<img
						class="badge"
						src="https://my.home-assistant.io/badges/hacs_repository.svg"
						alt="Open your Home Assistant instance and open this repository in HACS."
					/>
				</a>
				<a href="https://my.home-assistant.io/redirect/config_flow_start/?domain=boopli" target="_blank" rel="noreferrer">
					<img
						class="badge"
						src="https://my.home-assistant.io/badges/config_flow_start.svg"
						alt="Open your Home Assistant instance and start setting up Boopli."
					/>
				</a>
			</div>
			<div class="buttons">
				<a class="boopli-btn" href={`${base}/install/`}>Install Boopli</a>
				<a class="boopli-btn quiet" href={`${base}/setup/`}>Set it up</a>
			</div>
			<p class="small">Early development: Boopli is not ready for daily use yet. Free and open source (MIT).</p>
		</div>
		<img class="hero-art" src={`${base}/img/pet-room.png`} alt="Boopli the slime in its room, next to a water bowl, a food bowl and a bed" />
	</section>

	<section class="steps">
		<h2>Up and running in three steps</h2>
		<ol>
			<li><b>Add it.</b> Add the repository to HACS and download Boopli.</li>
			<li><b>Switch it on.</b> Add the Boopli integration under Settings, Devices &amp; services.</li>
			<li><b>Follow the wizard.</b> Open Boopli in the sidebar. A guide asks one question per screen.</li>
		</ol>
	</section>

	{
		features.map((f, i) => (
			<section class={`feature ${i % 2 ? 'flip' : ''}`}>
				<div class="feature-text">
					<h2>{f.title}</h2>
					<p>{f.text}</p>
					<a class="boopli-btn quiet" href={`${base}/${f.page}/`}>
						Read more
					</a>
				</div>
				<img src={`${base}/img/${f.image}`} alt={f.alt} loading="lazy" />
			</section>
		))
	}

	<section class="map">
		<h2>Find your way</h2>
		<div class="groups">
			{
				groups.map((g) => (
					<div class="group">
						<h3>{g.title}</h3>
						<ul>
							{g.pages.map(([slug, icon]) => (
								<li>
									<a href={`${base}/${slug}/`}>
										<span class="ico">
											<Icon name={icon as any} size="1.3rem" />
										</span>
										<span>
											<strong>{info(slug)?.title}</strong>
											<span class="d">{info(slug)?.description}</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section class="next">
		<h2>What is next</h2>
		<p class="small">Straight from the project's GitHub issues, so it is always current.</p>
		<Roadmap limit={3} more={true} />
	</section>
</div>

<style>
	.landing {
		display: grid;
		gap: 4.5rem;
		margin-top: 1rem;
	}
	.landing h1 {
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		line-height: 1.1;
		margin: 0 0 1rem;
	}
	.landing h2 {
		font-size: 2rem;
		margin: 0 0 0.8rem;
		border: 0;
	}
	.landing p {
		margin: 0;
	}
	.hero {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 2.5rem;
		align-items: center;
	}
	.lead {
		font-size: 1.3rem;
		line-height: 1.4;
		color: var(--sl-color-gray-1);
	}
	.buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		align-items: center;
		margin-top: 1.1rem;
	}
	.badge {
		height: 2.4rem;
		border: 0;
		border-radius: 0;
		display: block;
	}
	.small {
		margin-top: 1rem;
		font-size: 0.95rem;
		color: var(--sl-color-gray-3);
	}
	.hero-art {
		width: 100%;
		border-radius: 22px;
		border: 2px solid var(--sl-color-hairline-light);
	}
	.steps ol {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1.5rem;
		counter-reset: s;
	}
	.steps li {
		counter-increment: s;
		border-top: 3px solid var(--boopli-green);
		padding-top: 0.8rem;
		font-size: 1.15rem;
		line-height: 1.4;
	}
	.steps li::before {
		content: counter(s);
		display: inline-grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		margin-right: 0.6rem;
		border-radius: 50%;
		background: var(--boopli-green);
		color: var(--boopli-ink);
		font-size: 1.1rem;
	}
	.feature {
		display: grid;
		grid-template-columns: 1fr 1.25fr;
		gap: 2.5rem;
		align-items: center;
	}
	.feature.flip {
		grid-template-columns: 1.25fr 1fr;
	}
	.feature.flip .feature-text {
		order: 2;
	}
	.feature p {
		font-size: 1.2rem;
		line-height: 1.45;
		color: var(--sl-color-gray-1);
		margin-bottom: 1.1rem;
	}
	.feature img {
		width: 100%;
		border-radius: 18px;
		border: 2px solid var(--sl-color-hairline-light);
	}
	.groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
		gap: 2.2rem 2.5rem;
		margin-top: 1rem;
	}
	.group h3 {
		margin: 0 0 0.5rem;
		font-size: 1.3rem;
		color: var(--sl-color-accent-high);
		padding-bottom: 0.4rem;
		border-bottom: 3px solid var(--sl-color-hairline-light);
	}
	.group ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.group li a {
		display: flex;
		gap: 0.8rem;
		align-items: flex-start;
		padding: 0.6rem 0.5rem;
		border-radius: 12px;
		text-decoration: none;
		color: var(--sl-color-white);
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	.group li a:hover {
		background: var(--sl-color-gray-6);
	}
	.ico {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		border-radius: 10px;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
	}
	.group strong {
		display: block;
		font-weight: 400;
		font-size: 1.15rem;
	}
	.d {
		display: block;
		font-size: 0.95rem;
		color: var(--sl-color-gray-3);
		line-height: 1.3;
	}
	@media (max-width: 50rem) {
		.hero,
		.feature,
		.feature.flip {
			grid-template-columns: 1fr;
		}
		.feature.flip .feature-text {
			order: 0;
		}
		.landing {
			gap: 3rem;
		}
	}
</style>

<style is:global>
	/* the page title is the hero headline here, so Starlight's own title bar goes */
	body:has(.landing) .content-panel:has(> .sl-container > h1#_top) {
		display: none;
	}
	body:has(.landing) .main-pane .content-panel {
		padding-top: 0;
	}
</style>
